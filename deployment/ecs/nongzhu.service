[Unit]
Description=Nongzhu AI FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nongzhu
Group=nongzhu
WorkingDirectory=/opt/nongzhu/backend
EnvironmentFile=/opt/nongzhu/.env
ExecStart=/opt/nongzhu/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8017 --workers 1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
